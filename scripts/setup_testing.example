#!/bin/bash

# Extracts the value from the specified property (as $1) from the given file (as $2).
#
# The returned property is cut taking '=' as delimiter, then the result is extracted and returned.
# e.g. version=2.0.0 -> 2.0.0
extractProperty () {
  grep "$1" "$2" | cut -d'=' -f2
}

# Ensures the specified directory or file exists, otherwise exists the script with error.
ensureExistingDirOrFile () {
  if [ ! -d "$1" ]; then
    echo "fn ensureExistingDirOrFile(): Specified directory $1 doesn't exist.";
    exit 1
  fi
}

SERVER_PLUGINS_DIR="your-server-plugins-folder"
ensureExistingDirOrFile "$SERVER_PLUGINS_DIR"

# project-related variables.
PROJECT_NAME="project-name"
PROJECT_DIR="project-route"
ensureExistingDirOrFile "$PROJECT_DIR"

PROJECT_VERSION=$(extractProperty "version" "$PROJECT_DIR/gradle.properties")
echo "Extracted project version: $PROJECT_VERSION"
PROJECT_BUILT_FILE="$PROJECT_NAME-$PROJECT_VERSION.jar"
PROJECT_BUILT_FILE_ROUTE="builds-dir/$PROJECT_BUILT_FILE"
ensureExistingDirOrFile "$PROJECT_BUILT_FILE_ROUTE"

# plugin-file related variables.
PLUGIN_DATA_FOLDER_DIR="plugin-data-folder-route"
IN_PROD_FILE_DIR="in-production-plugin-jar-route"

# Delete the old data-folder the plugin created.
# let this thing as false only for initial-testing purposes, you don't want to lose testing-data accidentally :p.
DELETE_DATA_FOLDER=true
if [[ ! $DELETE_DATA_FOLDER || ! -d "$PLUGIN_DATA_FOLDER_DIR" ]]; then
  echo "Skipping data-folder deletion due to unexisting file or property set to false."
fi

rm -d "$IN_PROD_FILE_DIR"
echo "Plugin's old data-directory has been deleted."

if [ -f "$IN_PROD_FILE_DIR" ]; then
  rm "$IN_PROD_FILE_DIR"
  echo "Previous plugin-jar has been deleted from $IN_PROD_FILE_DIR."
fi

echo "Moving compiled-jar into plugins directory."

mv "$PROJECT_BUILT_FILE_ROUTE" "$SERVER_PLUGINS_DIR"
printf "\nThe file %s has been moved into the %s directory successfully!" "$PROJECT_BUILT_FILE" "$SERVER_PLUGINS_DIR"
printf "Script execution has finished correctly.\n"
exit 0